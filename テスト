<style>
:root {
    --red: #c9182b;
    --black: #101114;
    --silver: #bfc3ca;
    --white: #ffffff;
    --gray: #f2f3f5;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    margin: 0;
    color: #22252a;
    background: var(--gray);
    font-family: "Noto Sans JP", "Yu Gothic", Meiryo, sans-serif;
    line-height: 1.9;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    max-width: 100%;
}

button {
    font: inherit;
    cursor: pointer;
}

/* ヘッダー */

header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(16,17,20,.98);
    color: white;
    border-bottom: 3px solid var(--red);
}

.header-inner {
    max-width: 1500px;
    margin: auto;
    padding: 16px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.logo {
    font-size: 21px;
    font-weight: 900;
    letter-spacing: .06em;
}

.logo small {
    display: block;
    font-size: 10px;
    color: var(--silver);
    letter-spacing: .25em;
}

nav {
    display: flex;
    align-items: center;
    gap: 24px;
}

nav a {
    font-size: 13px;
    font-weight: bold;
    transition: .3s;
}

nav a:hover {
    color: #ff5363;
}

.menu-button {
    display: none;
    color: white;
    background: transparent;
    border: 1px solid #777;
    padding: 5px 12px;
}

/* メインビジュアル */

.hero {
    min-height: 650px;
    display: flex;
    align-items: center;
    color: white;
    padding: 100px 8%;
    background:
        linear-gradient(90deg, rgba(0,0,0,.88), rgba(0,0,0,.28)),
        url("store.jpg") center/cover no-repeat,
        #16181c;
}

.hero-inner {
    max-width: 850px;
}

.hero-label {
    color: #e6e6e6;
    font-size: 13px;
    letter-spacing: .3em;
    font-weight: bold;
}

.hero h1 {
    font-size: clamp(38px, 5.5vw, 78px);
    line-height: 1.35;
    margin: 22px 0;
    letter-spacing: .04em;
}

.hero h1 span {
    color: #ff4354;
}

.hero p {
    max-width: 650px;
    font-size: 17px;
    color: #e0e0e0;
}

.buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 30px;
}

.btn {
    display: inline-block;
    padding: 15px 30px;
    font-weight: bold;
    border: 1px solid transparent;
    transition: .3s;
}

.btn-red {
    background: var(--red);
    color: white;
}

.btn-red:hover {
    background: #a41020;
    transform: translateY(-3px);
}

.btn-outline {
    color: white;
    border-color: white;
}

.btn-outline:hover {
    background: white;
    color: black;
}

/* 共通セクション */

section {
    padding: 85px 7%;
}

.container {
    max-width: 1250px;
    margin: auto;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title .en {
    display: block;
    color: var(--red);
    font-size: clamp(28px, 4vw, 45px);
    font-weight: 900;
    letter-spacing: .12em;
    line-height: 1.3;
}

.section-title h2 {
    margin: 12px 0;
    font-size: 26px;
}

.section-title::after {
    content: "";
    display: block;
    width: 50px;
    height: 3px;
    background: var(--red);
    margin: 20px auto;
}

.section-title p {
    color: #777;
}

.white-section {
    background: white;
}

.dark-section {
    background: var(--black);
    color: white;
}

.dark-section .section-title p {
    color: #bbb;
}

/* お知らせ */

.notice {
    max-width: 1250px;
    margin: -35px auto 0;
    position: relative;
    background: white;
    padding: 30px 35px;
    border-left: 5px solid var(--red);
    box-shadow: 0 10px 35px #0002;
}

.notice h2 {
    color: var(--red);
    margin-top: 0;
}

.news-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid #ddd;
}

.news-date {
    color: #777;
    font-size: 14px;
}

.news-label {
    color: white;
    background: var(--red);
    padding: 3px 12px;
    font-size: 12px;
}

/* サービス */

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.service-card {
    background: white;
    border-bottom: 3px solid var(--red);
    padding: 32px;
    box-shadow: 0 5px 20px #0001;
    transition: .3s;
}

.service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px #0002;
}

.service-number {
    color: var(--red);
    font-size: 36px;
    font-weight: 900;
}

.service-card h3 {
    font-size: 23px;
    margin: 10px 0;
}

.service-card p {
    color: #666;
    font-size: 14px;
}

.more {
    display: inline-block;
    color: var(--red);
    font-weight: bold;
    margin-top: 15px;
}

/* 事業詳細 */

.detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 55px;
    align-items: center;
}

.detail.reverse .detail-visual {
    order: 2;
}

.detail-visual {
    min-height: 320px;
    background: linear-gradient(135deg, #101114, #34373d);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px;
    border-bottom: 5px solid var(--red);
    text-align: center;
}

.detail-visual .big-number {
    font-size: 75px;
    font-weight: 900;
    color: #ffffff25;
    line-height: 1;
}

.detail-visual strong {
    font-size: 28px;
    letter-spacing: .1em;
}

.detail-visual small {
    color: #bbb;
    letter-spacing: .15em;
}

.detail-text h2 {
    font-size: 32px;
    margin: 10px 0 20px;
}

.detail-text .en {
    color: var(--red);
    font-weight: bold;
    letter-spacing: .15em;
}

.check-list {
    list-style: none;
    padding: 0;
}

.check-list li {
    padding: 10px 0;
    border-bottom: 1px solid #ddd;
}

.check-list li::before {
    content: "✓";
    color: var(--red);
    font-weight: bold;
    margin-right: 12px;
}

/* 特徴 */

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.feature {
    padding: 30px;
    border: 1px solid #414349;
}

.feature strong {
    display: block;
    color: #ff4354;
    font-size: 36px;
}

.feature h3 {
    font-size: 21px;
}

.feature p {
    color: #bbb;
    font-size: 14px;
}

/* 車検の流れ */

.flow-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
}

.flow-item {
    background: white;
    padding: 25px 18px;
    border-top: 4px solid var(--red);
}

.flow-item small {
    color: var(--red);
    font-weight: bold;
}

.flow-item h3 {
    font-size: 18px;
}

.flow-item p {
    font-size: 14px;
    color: #666;
}

/* 会社情報 */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
}

.store-photo {
    width: 100%;
    min-height: 300px;
    background: #222 url("store.jpg") center/cover no-repeat;
    border-bottom: 5px solid var(--red);
}

.history {
    margin: 30px 0;
    border-left: 2px solid var(--red);
    padding-left: 25px;
}

.history-item {
    margin-bottom: 30px;
}

.history-item strong {
    color: var(--red);
    font-size: 24px;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

th, td {
    padding: 20px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

th {
    width: 25%;
    background: #e9eaed;
}

/* FAQ */

details {
    background: white;
    margin-bottom: 14px;
    border-left: 3px solid var(--red);
}

summary {
    padding: 22px;
    cursor: pointer;
    font-weight: bold;
}

details p {
    margin: 0;
    padding: 0 25px 25px;
    color: #555;
}

/* 地図 */

.map {
    width: 100%;
    height: 420px;
    border: 0;
    margin-top: 25px;
}

/* お問い合わせ */

.contact {
    background: #101114;
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.contact::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("main-logo.png") center/contain no-repeat;
    opacity: .04;
    pointer-events: none;
}

.contact .container {
    position: relative;
}

.contact .tel {
    font-size: clamp(30px, 5vw, 60px);
    font-weight: 900;
    letter-spacing: .05em;
    margin: 15px 0;
}

.contact-hours {
    margin: 25px auto;
    max-width: 500px;
    padding: 20px;
    border: 1px solid #555;
}

/* フッター */

footer {
    background: #08090b;
    color: #aaa;
    padding: 45px 7% 25px;
}

.footer-grid {
    max-width: 1250px;
    margin: auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 30px;
}

footer h3 {
    color: white;
}

footer a {
    display: block;
    font-size: 14px;
    padding: 5px 0;
}

.copyright {
    text-align: center;
    border-top: 1px solid #333;
    margin-top: 30px;
    padding-top: 20px;
    font-size: 12px;
}

.back-top {
    position: fixed;
    right: 20px;
    bottom: 25px;
    z-index: 90;
    background: var(--red);
    color: white;
    padding: 10px 16px;
    font-weight: bold;
}

.mobile-contact {
    display: none;
}

/* アニメーション */

.js .reveal {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity .7s, transform .7s;
}

.js .reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

/* スマートフォン対応 */

@media(max-width: 1000px) {
    .menu-button {
        display: block;
    }

    nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: #101114;
        padding: 20px 7%;
    }

    nav.open {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .service-grid,
    .feature-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .flow-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .detail,
    .about-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .detail.reverse .detail-visual {
        order: 0;
    }
}

@media(max-width: 600px) {
    .hero {
        min-height: 540px;
        padding: 70px 6%;
    }

    section {
        padding: 55px 6%;
    }

    .logo {
        font-size: 17px;
    }

    .service-grid,
    .feature-grid,
    .flow-grid,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .notice {
        margin: -25px 5% 0;
        padding: 22px;
    }

    .news-item {
        flex-wrap: wrap;
        gap: 8px;
    }

    .detail-visual {
        min-height: 230px;
    }

    th, td {
        padding: 12px;
        font-size: 13px;
    }

    .map {
        height: 300px;
    }

    .mobile-contact {
        display: block;
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 12px;
        background: var(--red);
        color: white;
        text-align: center;
        font-weight: bold;
        z-index: 99;
    }

    .back-top {
        bottom: 75px;
    }

    body {
        padding-bottom: 55px;
    }
}

@media(prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    .js .reveal {
        opacity: 1;
        transform: none;
        transition: none;
    }
}
</style>
